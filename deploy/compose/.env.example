# Copy to <repo-root>/.env and edit. See plan.md §14 for the full var list.

# Deployment
DEPLOYMENT_MODE=standard

# Datastores (compose defaults)
DATABASE_URL=postgresql+asyncpg://crv:crv@postgres:5432/crv
QUEUE_BACKEND=redis
QUEUE_URL=redis://redis:6379/0
STORAGE_BACKEND=fs
STORAGE_URI=/var/lib/crv/objects
SECRETS_BACKEND=env
RUNNER_BACKEND=local

# Auth
AUTH_MODE=local
SEED_ADMIN_PASSWORD=admin123
SEED_USER_PASSWORD=user123

# LLM — pick one of the blocks below and delete the rest

## OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY_REF=OPENAI_API_KEY
OPENAI_API_KEY=sk-replace-me
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_DEEP=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024

## Local Ollama (airgap-friendly)
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_API_KEY_REF=OLLAMA_API_KEY
# OLLAMA_API_KEY=not-required
# LLM_MODEL_FAST=llama3.1:8b
# LLM_MODEL_DEEP=llama3.1:70b
# LLM_EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768

# Gate
GATE_MODE=fail_open
GATE_BLOCK_SEVERITY=high

# Budget
LLM_MONTHLY_BUDGET_USD=500

# Observability
LOG_LEVEL=info
TZ=UTC
