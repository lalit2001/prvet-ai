# Local dev — Copy this to .env at root directory and customize.
# See plan.md §14 for the full variable list.

DEPLOYMENT_MODE=standard

# --- Datastores (your local ones) ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crv
QUEUE_BACKEND=redis
QUEUE_URL=redis://localhost:6379/0
STORAGE_BACKEND=fs
STORAGE_URI=./data/objects
SECRETS_BACKEND=env
RUNNER_BACKEND=local

# --- Auth ---
AUTH_MODE=local
SEED_ADMIN_PASSWORD=admin123
SEED_USER_PASSWORD=user123
JWT_SECRET=crv-jwt-secret-keep-it-safe-for-dev

# --- LLM — fill in one block ---

## OpenAI (default)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY_REF=OPENAI_API_KEY
OPENAI_API_KEY=
LLM_MODEL_FAST=gpt-4o-mini
LLM_MODEL_DEEP=gpt-4o
LLM_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1024

## Anthropic (uncomment + set)
# LLM_BASE_URL=https://api.anthropic.com/v1
# LLM_API_KEY_REF=ANTHROPIC_API_KEY
# ANTHROPIC_API_KEY=
# LLM_MODEL_FAST=claude-haiku-4-5-20251001
# LLM_MODEL_DEEP=claude-sonnet-4-6
# LLM_EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=1024

## Local Ollama (airgap-friendly)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY_REF=OLLAMA_API_KEY
# OLLAMA_API_KEY=not-required
# LLM_MODEL_FAST=llama3.1:8b
# LLM_MODEL_DEEP=llama3.1:70b
# LLM_EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768

# --- Gate ---
GATE_MODE=fail_open
GATE_BLOCK_SEVERITY=high

# --- Budget ---
LLM_MONTHLY_BUDGET_USD=500

# --- Observability ---
LOG_LEVEL=info
TZ=UTC
